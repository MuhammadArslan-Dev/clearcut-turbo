# Base URL of the clearcut-tools-backend API (routes/api_v1.php there).
# Read only at BUILD TIME (src/lib/api/toolsApi.ts, called from
# generateStaticParams/generateMetadata/page renders) — never sent to the
# browser, matching this app's "no backend calls at runtime" static-export
# architecture (see next.config.ts). No NEXT_PUBLIC_ prefix on purpose.
TOOLS_API_URL=http://clearcut-tools-backend.test/api/v1

# Main Laravel backend (clearcutoff-main-backend) — read at RUNTIME in the
# browser (unlike TOOLS_API_URL above) by the Syllabus Tracker only, to
# fetch the public, read-only exam/level/syllabus endpoints
# (routes/Apis/Tools/syllabus.php there). Same var name as apps/dashboard's,
# per the Aug 2026 backend-URL consolidation. Deliberately public/no-auth —
# never used for anything user-specific.
NEXT_PUBLIC_LARAVEL_MAIN_BACKEND=http://clearcutoff-main-backend.test/api
