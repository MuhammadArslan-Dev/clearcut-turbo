# Base URL of the clearcut-tools-backend API (routes/api_v1.php there).
# Read only at BUILD TIME (src/lib/api/toolsApi.ts, called from
# generateStaticParams/generateMetadata/page renders) — never sent to the
# browser, matching this app's "no backend calls at runtime" static-export
# architecture (see next.config.ts). No NEXT_PUBLIC_ prefix on purpose.
TOOLS_API_URL=http://clearcut-tools-backend.test/api/v1

# Main Laravel backend (clearcutoff-main-backend) — read at RUNTIME in the
# browser (unlike TOOLS_API_URL above) by the Syllabus Tracker only, to
# fetch the public, read-only exam/level/syllabus endpoints
# (routes/Apis/Tools/syllabus.php there), and — only after the visitor logs in
# and taps "Save for Future" — the per-user tracker endpoints and the phone/OTP
# login (routes/Apis/Tools/syllabus-tracker.php, /v1/auth/*). Same var name as
# apps/dashboard's, per the Aug 2026 backend-URL consolidation. Must include
# the trailing /api.
NEXT_PUBLIC_LARAVEL_MAIN_BACKEND=http://clearcutoff-main-backend.test/api

# Amplitude (src/lib/toolsAnalytics.ts) — records the auth funnel (e.g.
# Verification Sent / Resent) and a "Page Viewed" event on every page/route
# (components/analytics/PageViewTracker.tsx). Defaults to enabled with the
# shared public key apps/blog/landing also fall back to — zero setup
# needed. Set ENABLED=false to turn tracking off (e.g. local dev). Static
# export: both read at BUILD time.
NEXT_PUBLIC_AMPLITUDE_ENABLED=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Sentry error tracking (src/lib/page-errors.ts) — lazy-loads @sentry/browser
# only when NEXT_PUBLIC_SENTRY_DSN is set, scrubs via @clearcut/error-reporting's
# redact helpers. Static export: read at BUILD time, so this must be set in the
# Cloudflare Pages build environment (not just a local .env) or production stays
# inert. Add NEXT_PUBLIC_SENTRY_ENVIRONMENT=production alongside it.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# GTM + Microsoft Clarity (@clearcut/analytics, src/app/layout.tsx). GTM
# defaults to the same shared production container blog/landing use
# (GTM-WC2GWW9Z) — zero setup needed, same "blank = off" override pattern as
# everywhere else; set this only to point tools at a different container.
# Both also gate on NODE_ENV === "production" internally (packages/analytics/
# src/env.ts), so `next dev` never loads either. Clarity has no shared default
# to fall back to — leave blank to keep it off, or set a project ID specific
# to tools.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
