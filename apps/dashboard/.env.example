# apps/dashboard — copy to `.env` and fill in.
# `.env` is gitignored; this file is committed and must never hold real secrets.

# ── Backend (Laravel) ───────────────────────────────────────────────────────
# NOTE the trailing /api — the API clients concatenate paths directly
# (`${BASE}/v1/auth-user`), so the base URL must already include it.

# Single canonical var — needs the NEXT_PUBLIC_ prefix because client-side
# code (lib/api/client.ts, lib/api/apiClient.ts) reads it from the browser
# bundle; Next.js exposes NEXT_PUBLIC_ vars server-side too, so the same var
# also covers the route handlers and lib/server-fetch.ts. Read with a
# non-null assertion in a few spots (e.g. app/api/auth/login/route.ts), so
# leaving it unset makes those routes fetch "undefined/auth/login".
NEXT_PUBLIC_LARAVEL_MAIN_BACKEND=http://clearcutoff-main-backend.test/api

# This app's own origin — used by the couple of onboarding flows that build
# an absolute `window.location.href` redirect back into this app (a hard
# reload, not a relative router.push) instead of a relative path. Set this to
# a staging dashboard host in staging so those redirects don't bounce users
# back to production; unset falls back to production
# (see lib/frontend-url.ts).
NEXT_PUBLIC_FRONTEND_URL=https://app.clearcutoff.in

# ── Analytics ───────────────────────────────────────────────────────────────
# Amplitude is ON by default; set this to "false" to switch it (and the Rs 99 offer's
# Experiment SDK) off for a build. Localhost and preview hosts are already kept out of the
# live project by analyticsAllowedHere() (production hosts only), whatever this says.
NEXT_PUBLIC_AMPLITUDE_ENABLED=false

# Allow-listed Rs 99 autopay offer (docs/phases/66). Who sees Rs 99 and on which exams is controlled
# ONLY in Amplitude (flag `autopay-offer-99`); disable the flag there = everyone on default prices.
# The Amplitude Experiment CLIENT deployment key is hardcoded in src/lib/experiments/config.ts (client
# keys are public), so none of these variables is needed. Optional overrides:
#   NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_KEY=client-xxxx   use another deployment for this build
#   NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_KEY=off           switch the SDK off for this build
# The offer also needs Amplitude on (NEXT_PUBLIC_AMPLITUDE_ENABLED not "false") and a production analytics host.
NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_KEY=
# "us" (default) or "eu": must match the Amplitude project's data region.
NEXT_PUBLIC_AMPLITUDE_EXPERIMENT_SERVER_ZONE=
# Optional, comma-separated user uuids of the team: sent to Amplitude as the user property
# internal_tester=true so a targeting rule on that property matches them at once.
NEXT_PUBLIC_EXPERIMENT_INTERNAL_UUIDS=

# Microsoft Clarity project ID. Blank = off; also gated on
# NODE_ENV === "production" (see components/thirdparties/LazyClarity.tsx).
NEXT_PUBLIC_CLARITY_ID=

# ── Sentry (error tracking) ─────────────────────────────────────────────────
# The DSN is public by design (it ships inside the browser bundle), but it lives
# in env so staging and production can point at different Sentry projects.
# Read by all three runtimes — browser, node server, edge — through
# src/lib/sentry/sentry-shared.ts. Leave empty to disable Sentry entirely; the
# SDK is explicitly `enabled: Boolean(DSN)`, so an empty value is a clean no-op.
NEXT_PUBLIC_SENTRY_DSN=

# Tags every event, so local noise is never mistaken for a production incident.
# Use "development" / "staging" / "production".
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Source-map upload at build time, used by withSentryConfig in next.config.ts.
# WITHOUT THIS, PRODUCTION STACK TRACES STAY MINIFIED — you get
# "t is not a function" at main-abc123.js:1 instead of a real file and line.
# Create one at https://sentry.io/settings/clear-cutoff/auth-tokens/ with the
# `project:releases` scope. Needed only for production builds / CI.
SENTRY_AUTH_TOKEN=

# Meta Pixel is OFF on localhost / LAN IPs (CC-115 Part A). To test Pixel
# events locally, run localStorage.setItem("cc-meta-pixel-local", "1") in the
# browser console and reload. Optional: a separate TEST pixel id so those
# local events never reach the live pixel's data (create it in Meta Events
# Manager). Leave empty to send local test events to the live pixel.
NEXT_PUBLIC_FB_PIXEL_ID_TEST=
