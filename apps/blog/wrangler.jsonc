{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcut-blog",
  // worker.ts wraps OpenNext's generated .open-next/worker.js: it answers the
  // old /question/<slug>-<id> redirects from a build-time map before Next
  // loads (see worker.ts), and marks the staging Worker noindex.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets the worker call itself (OpenNext uses it for internal sub-requests).
  // Must match "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clearcut-blog"
    }
  ],
  // Second-tier incremental cache (open-next.config.ts): pages that were not
  // prerendered at build time are rendered once on request and kept here, so
  // they are not rendered again. Prerendered pages are read from the static
  // assets above instead. Binding name is fixed by @opennextjs/cloudflare.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "clearcut-blog-incremental-cache"
    }
  ],
  // History of the OpenNext ISR queue Durable Object. v1 was applied by the
  // 2026-10-21 deploy; v2 (the 2026-10-21 hotfix) deleted it again. The
  // Worker no longer uses a queue (no time-based ISR — pages are rebuilt), so
  // there is no durable_objects binding. Cloudflare refuses deploys whose
  // migrations are behind the live ones, so both stay listed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] },
    { "tag": "v2", "deleted_classes": ["DOQueueHandler"] }
  ],
  // Runtime (non-NEXT_PUBLIC_*) value this app reads at request time:
  // BACKEND_URL (src/lib/api/api2.ts, sitemap route handlers), passed by the
  // deploy workflow. BLOG_SERVER_KEY / REVALIDATE_SECRET live in code
  // (src/lib/api/blog-server-key.ts); a Worker secret of the same name would
  // override them. Everything else is NEXT_PUBLIC_* and inlined at build time.
  "env": {
    // Isolated test Worker (https://clearcut-blog-staging.<account>.workers.dev),
    // deployed by .github/workflows/deploy-blog-staging.yml. Its own R2 bucket;
    // never bound to the production domain. Bindings are not inherited by
    // wrangler environments, so each is repeated here.
    "staging": {
      "name": "clearcut-blog-staging",
      "workers_dev": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "clearcut-blog-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "clearcut-blog-staging-cache"
        }
      ],
      "vars": {
        // worker.ts adds X-Robots-Tag: noindex to every staging response.
        "STAGING": "1"
      }
    }
  }
}
