{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcut-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets the worker call itself, which OpenNext needs for background ISR
  // revalidation. Must match "name" above. No extra setup needed — Cloudflare
  // resolves this once the worker with this name exists (itself).
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clearcut-blog"
    }
  ],
  // Backs OpenNext's R2 incremental cache (see open-next.config.ts) — the
  // binding name "NEXT_INC_CACHE_R2_BUCKET" is fixed, read directly by
  // @opennextjs/cloudflare's r2-incremental-cache.js, not configurable here.
  // Bucket created in the Cloudflare dashboard 2026-10-20 (public access off).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "clearcut-blog-incremental-cache"
    }
  ],
  // OpenNext's ISR revalidation queue (open-next.config.ts `queue: doQueue`).
  // Binding name and class name are fixed by @opennextjs/cloudflare; the class
  // is exported by the generated .open-next/worker.js. Created on deploy by
  // the migration below — nothing to create by hand.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // OpenNext's tag cache for revalidatePath/revalidateTag (open-next.config.ts
  // `tagCache: d1NextTagCache`). Binding name is fixed. Database created in the
  // Cloudflare dashboard 2026-10-20. Its `revalidations` table is created by
  // `opennextjs-cloudflare populateCache remote` (the deploy workflow's
  // "Populate OpenNext caches" step). See docs/BLOG_CACHE_DEPLOY.md.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "clearcut-blog-tag-cache",
      "database_id": "8e698f75-f2e9-47af-9516-83c535ab8038"
    }
  ]
  // Runtime (non-NEXT_PUBLIC_*) value this app reads at request time:
  // BACKEND_URL (src/lib/api/api2.ts, sitemap route handlers), passed by the
  // deploy workflow. BLOG_SERVER_KEY / REVALIDATE_SECRET live in code
  // (src/lib/api/blog-server-key.ts); a Worker secret of the same name would
  // override them. Everything else is NEXT_PUBLIC_* and inlined at build time.
}
