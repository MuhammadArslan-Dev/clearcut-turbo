# Copy to .env (local) or set as Coolify secrets. NEVER commit real values.

# Google Cloud OAuth client (type: Web application). Can be the SAME client as the Google Ads MCP:
# just add this server's redirect URI to it.
GA_MCP_OAUTH_CLIENT_ID=
GA_MCP_OAUTH_CLIENT_SECRET=
# Public URL of this server. Redirect URI to register in Google Cloud:
#   ${GA_MCP_BASE_URL}/auth/callback
GA_MCP_BASE_URL=https://mcp-ga.clearcutoff.in

# Who may sign in: comma/space separated emails and/or @domains. REQUIRED when OAuth is on.
ALLOWED_EMAILS=

# Persisted, encrypted OAuth state (survives restarts). Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
GA_MCP_JWT_SIGNING_KEY=
GA_MCP_STORAGE_TYPE=filetree
GA_MCP_STORAGE_PATH=/var/lib/analytics-mcp
GA_MCP_STORAGE_ENCRYPTION_KEY=
