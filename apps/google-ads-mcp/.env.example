# Copy to .env (local) or set as Coolify secrets. NEVER commit real values.

# Google Cloud OAuth client (type: Web application) used for team sign-in.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
# Public URL of this server. Redirect URI to register in Google Cloud:
#   ${GOOGLE_ADS_MCP_BASE_URL}/auth/callback
GOOGLE_ADS_MCP_BASE_URL=https://mcp-ads.clearcutoff.in

# Identifies our app to Google Ads (Google Ads > Tools > API Center). Needs Basic access for production.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account id, digits only. Leave empty if not using a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Who may sign in: comma/space separated emails and/or @domains. REQUIRED when OAuth is on.
ALLOWED_EMAILS=

# Persisted, encrypted OAuth state (survives restarts). Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=
GOOGLE_ADS_MCP_STORAGE_TYPE=filetree
GOOGLE_ADS_MCP_STORAGE_PATH=/var/lib/google-ads-mcp
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=
